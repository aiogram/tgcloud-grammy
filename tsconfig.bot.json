{
  // Preset for bot projects: `{ "extends": "@aiogram/tgcloud-grammy/tsconfig.json", "include": ["src"] }`.
  // Type-checks only; `tgcloud-grammy build` does the compiling.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    // No DOM and no Node: the runtime is a bare V8 isolate.
    "lib": ["ES2022"],
    "types": ["@aiogram/tgcloud-grammy/sdk"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  }
}
