{
  // Runtime code (bundled into bots): checked against the platform's globals only.
  "compilerOptions": {
    "target": "ES2025",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2025"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src", "types"],
  "exclude": ["src/cli.ts", "src/init.ts"]
}
